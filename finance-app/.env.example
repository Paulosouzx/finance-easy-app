# FinanceApp — Variáveis de ambiente
# Copia este ficheiro para .env e preenche os valores reais.
# O ficheiro .env nunca deve ser commitado (está no .gitignore).

# ─── Supabase ─────────────────────────────────────────────
# Encontras estas chaves em: Supabase > Project Settings > API

VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ─── Web Push (lembrete de registo de gastos) ────────────────
# Gera o par de chaves com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=<public-key>

# ─── Dev server (opcional — usa os defaults se não definido) ─
# PORT=5173
# BASE_PATH=/
